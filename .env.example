# ── Required ─────────────────────────────────────────────────────────
BOT_TOKEN=123456:your-telegram-bot-token        # from @BotFather
SHOP_URL=https://your-shop.com                   # the store the bot mirrors

# ── Recommended ──────────────────────────────────────────────────────
SHOP_NAME=Your Shop                              # shown on the start screen

# ── Optional ─────────────────────────────────────────────────────────
# ADMIN_HANDLE=@your_username                     # enables the wholesale inquiry flow
# SHOP_TAGLINE=One-line blurb for the start screen
# SHOP_BADGES=🚚 Free shipping  ·  💳 Cards accepted
# BANNER_IMG=assets/start-banner.png             # path or URL to the start banner
# DEFAULT_LANGUAGE=en                            # en | de | es | pt | nl
# ENABLE_SEMANTIC_SEARCH=0                        # 1 to use sentence-transformers + FAISS
# RESTRICTED_KEYWORDS=                            # comma-separated terms to hide (regulated stores)
